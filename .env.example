# PostgreSQL
POSTGRES_USER=gmao
POSTGRES_PASSWORD=gmao_dev_password
POSTGRES_DB=gmao_db
DATABASE_URL="postgresql://gmao:gmao_dev_password@localhost:5432/gmao_db"

# Redis
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_ROOT_USER=gmao_minio
MINIO_ROOT_PASSWORD=gmao_minio_password
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_PHOTOS=photos
MINIO_BUCKET_REPORTS=reports
MINIO_ENDPOINT=http://localhost:9000

# MailHog
SMTP_HOST=localhost
SMTP_PORT=1025

# JWT
JWT_ACCESS_SECRET=change_me_in_production_access
JWT_REFRESH_SECRET=change_me_in_production_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
APP_URL=http://localhost:3000

# MinIO / Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_BUCKET=gmao
STORAGE_PRESIGNED_TTL_SECONDS=3600

# Storage — presigned URL TTL (not in Joi schema, safe default hardcoded in service)
# STORAGE_PRESIGNED_TTL_SECONDS=3600
MINIO_ROOT_USER=gmao_minio
MINIO_ROOT_PASSWORD=gmao_minio_password
