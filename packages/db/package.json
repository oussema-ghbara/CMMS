{
  "name": "@gmao/db",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').cpSync('src/generated', 'dist/generated', { recursive: true })\"",
    "dev": "tsc --watch",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.seed.json prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "prisma": "^6.7.0",
    "typescript": "^5.8.3",
    "ts-node": "^10.9.2",
    "@types/node": "^22.15.3",
    "@types/bcryptjs": "^2.4.6"
  }
}
